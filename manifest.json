{
  "manifest_version": 3,
  "name": "Filli AI – QA Edge-Case & Form Test Data Filler",
  "version": "1.0.0",
  "description": "Instant QA edge-case, boundary & context-aware AI test data form filler for developers.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus", "webNavigation"],
  "host_permissions": [
    "https://autofill-ai-proxy.vinaykondabattula.workers.dev/"
  ],
  "optional_host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "icons": {
    "16": "public/icon-16.png",
    "32": "public/icon-32.png",
    "48": "public/icon-48.png",
    "128": "public/icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "public/icon-16.png",
      "32": "public/icon-32.png",
      "48": "public/icon-48.png",
      "128": "public/icon-128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.ts"],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["options.html"],
      "matches": ["https://uipnnsbbdsgchgphvliw.supabase.co/*"]
    }
  ]
}
